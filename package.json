{
  "name": "an-hoa-hand-seal-game",
  "version": "0.3.0",
  "private": true,
  "description": "First-person nine-element ninja duel with hand seals and pre-battle loadouts",
  "scripts": {
    "start": "node server.cjs",
    "build": "node tools/build.mjs",
    "build:vercel": "node tools/build-vercel.mjs",
    "assets": "node tools/build-hands.mjs",
    "test": "node tests/core.cjs && node tests/server.cjs && node tests/hands.mjs && node tests/hand-volume.mjs",
    "test:hand-volume": "node tests/hand-volume.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:loadout": "node tests/loadout.cjs",
    "test:graphics": "node tests/graphics.cjs",
    "test:anime": "node tests/anime-style.cjs",
    "preview:capture": "node tools/capture.cjs",
    "test:layout": "node tests/layout.cjs",
    "test:controls": "node tests/controls.cjs",
    "test:ranks": "node tests/ranks.cjs",
    "test:incantation": "node tests/incantation.cjs",
    "test:fire": "node tests/fire.cjs",
    "test:water": "node tests/water.cjs",
    "test:lightning": "node tests/lightning.cjs",
    "test:dark": "node tests/dark.cjs",
    "test:wind": "node tests/wind.cjs",
    "test:hand-vfx": "node tests/hand-vfx.cjs",
    "test:meteor-zoom": "node tests/meteor-zoom.cjs",
    "test:impact-motion": "node tests/impact-motion.cjs",
    "test:wind-camera": "node tests/wind-camera.cjs",
    "test:wind-spirit": "node tests/wind-spirit.cjs",
    "test:light": "node tests/light-core.mjs && node tests/light.cjs",
    "test:earth": "node tests/earth-core.mjs && node tests/earth.cjs",
    "test:nature": "node tests/nature-core.mjs && node tests/nature.cjs",
    "test:hand-element-rings": "node tests/hand-element-rings.cjs",
    "test:cooldowns": "node tests/cooldowns-shuriken.cjs",
    "test:combat": "node tests/combat-core.mjs && node tests/combat.cjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "^1.56.0"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
